	if obj and obj.PrimaryPart then
		updateHighlight(hlMine, obj, Toggles.HighlightMine.Value)
		pcall(function()
			TSG.MineRemote:FireServer(slot, obj, CFrame.new(obj.PrimaryPart.Position))
		end)
	end
