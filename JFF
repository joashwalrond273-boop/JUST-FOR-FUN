do
	local particleConnections = {}
	local originalEnabledStates = setmetatable({}, { __mode = "k" })

	local function disableParticle(v)
		if not (v:IsA("ParticleEmitter") or v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles")) then return end

		local particlesFolder = ReplicatedStorage:FindFirstChild("Particles")
		if not particlesFolder then return end

		if particlesFolder:FindFirstChild(v.Name, true) then
			if originalEnabledStates[v] == nil then
				originalEnabledStates[v] = v.Enabled
			end
			pcall(function()
				v.Enabled = false
			end)

			local conn = v:GetPropertyChangedSignal("Enabled"):Connect(function()
				if Toggles.RemoveParticles and Toggles.RemoveParticles.Value and v.Enabled then
					pcall(function()
						v.Enabled = false
					end)
				end
			end)
			table.insert(particleConnections, conn)
		end
	end

	VisualFPS:AddToggle("RemoveParticles", {
		Text = "Remove Particles",
		Default = false,
		Callback = function(state)
			disconnect("RemoveParticles")
			for _, conn in ipairs(particleConnections) do
				pcall(function() conn:Disconnect() end)
			end
			table.clear(particleConnections)

			if state then
				-- Disable current particles in ReplicatedStorage.Particles
				local particlesFolder = ReplicatedStorage:FindFirstChild("Particles")
				if particlesFolder then
					for _, v in ipairs(particlesFolder:GetDescendants()) do
						disableParticle(v)
					end
					-- Listen for new templates added to ReplicatedStorage
					track("RemoveParticles_Templates", particlesFolder.DescendantAdded:Connect(disableParticle))
				end

				-- Disable existing particles in workspace
				for _, v in ipairs(workspace:GetDescendants()) do
					disableParticle(v)
				end

				-- Listen for new particles added to workspace
				track("RemoveParticles_Workspace", workspace.DescendantAdded:Connect(disableParticle))
			else
				disconnect("RemoveParticles_Templates")
				disconnect("RemoveParticles_Workspace")

				-- Restore original states
				for v, originalState in pairs(originalEnabledStates) do
					if v and v.Parent then
						pcall(function()
							v.Enabled = originalState
						end)
					end
				end
