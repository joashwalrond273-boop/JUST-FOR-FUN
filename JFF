			else
				local children = nil
				pcall(function() children = Lighting:GetChildren() end)
				if children then
					for _, v in ipairs(children) do
						restorePost(v)
					end
				end
				table.clear(originalPostEnabled)
				Library:Notify({ Title = "Kill Heavy Post FX", Description = "Disabled", Time = 2 })
			end
		end,
	})
end

