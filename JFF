local lastDodgeTime = 0
local dodgeCooldown = 0.45

local function performInstantDodgeBehind(enemyRoot)
	if not enemyRoot or not enemyRoot.Parent or not isAlive() then return end
	local root = getRootPart()
	if not root then return end

	lastDodgeTime = tick()

	local enemyCFrame = enemyRoot.CFrame
	local enemyLook = enemyCFrame.LookVector
	local flatLook = Vector3.new(enemyLook.X, 0, enemyLook.Z)
	if flatLook.Magnitude < 0.05 then
		flatLook = Vector3.new(0, 0, 1)
	else
		flatLook = flatLook.Unit
	end

	-- Instant teleport 5 studs directly behind the enemy, facing their back
	local behindPos = enemyRoot.Position - (flatLook * 5)
	root.CFrame = CFrame.lookAt(behindPos, Vector3.new(enemyRoot.Position.X, behindPos.Y, enemyRoot.Position.Z))
end

local function checkAndPerformDodge()
	if not isAlive() or not Toggles.DodgeAura or not Toggles.DodgeAura.Value then return end
	if tick() - lastDodgeTime < dodgeCooldown then return end

	local root = getRootPart()
	if not root then return end

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer and player.Character then
			local enemyRoot = player.Character:FindFirstChild("HumanoidRootPart")
			local hum = player.Character:FindFirstChildOfClass("Humanoid")
			if enemyRoot and hum and hum.Health > 0 then
				local dist = (enemyRoot.Position - root.Position).Magnitude
				if dist <= 10 then
					local isSwinging = false
					local animator = hum:FindFirstChild("Animator")
					if animator then
						for _, trackObj in ipairs(animator:GetPlayingAnimationTracks()) do
							if trackObj.Speed > 0 and isSwingAnimation(trackObj) then
								isSwinging = true
								break
							end
						end
					end

					if isSwinging then
						performInstantDodgeBehind(enemyRoot)
						break
					end
				end
			end
		end
	end
end

local function hookEnemyDodgeAnimator(animator, enemyChar)
	if not animator then return end
	track("DodgeAnim_" .. enemyChar.Name, animator.AnimationPlayed:Connect(function(trackObj)
		if not Toggles.DodgeAura or not Toggles.DodgeAura.Value or not isAlive() then return end
		if tick() - lastDodgeTime < dodgeCooldown then return end
		if not isSwingAnimation(trackObj) then return end

		local root = getRootPart()
		local enemyRoot = enemyChar:FindFirstChild("HumanoidRootPart")
		if not root or not enemyRoot then return end

		local dist = (enemyRoot.Position - root.Position).Magnitude
		if dist <= 10 then
			performInstantDodgeBehind(enemyRoot)
		end
	end))
end

