local lastThrottledUpdate = 0

local function updateAllESP()
	if not Toggles.PlayerESP or not Toggles.PlayerESP.Value then return end

	local myRoot = getRootPart()
	local myPos = myRoot and myRoot.Position
	local now = tick()
	local shouldThrottle = (now - lastThrottledUpdate >= 0.1)

	if shouldThrottle then
		lastThrottledUpdate = now
	end

	local maxDist = (Options and Options.ESPDistance and Options.ESPDistance.Value) or 500
	local showDist = (Toggles and Toggles.ShowDistance and Toggles.ShowDistance.Value) or false
	local showHealth = (Toggles and Toggles.PlayerHealthBar and Toggles.PlayerHealthBar.Value) or false
	local showHpText = (Toggles and Toggles.ShowHealthText and Toggles.ShowHealthText.Value) or false
	local outlineEnabled = (Toggles.OutlineESP and Toggles.OutlineESP.Value) or false

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local entry = getOrCreateESP(player)
			if entry and entry.root and entry.hum and entry.hum.Health > 0 and entry.character.Parent then
				local dist = myPos and (entry.root.Position - myPos).Magnitude or 0
				local inRange = (dist <= maxDist)

				-- Native Billboard handles 3D position automatically via C++
				if entry.billboard.Enabled ~= inRange then
					entry.billboard.Enabled = inRange
				end

				if entry.highlight then
					local shouldHl = outlineEnabled and inRange and (dist <= 250)
					if entry.highlight.Enabled ~= shouldHl then
						entry.highlight.Enabled = shouldHl
					end
				end

				-- Throttled text and health updates (0 FPS drop)
				if inRange and shouldThrottle then
					if showDist then
						local roundedDist = math.floor(dist)
						if entry.lastDist ~= roundedDist then
							entry.lastDist = roundedDist
							entry.distLabel.Text = tostring(roundedDist) .. "m"
						end
						if not entry.distLabel.Visible then
							entry.distLabel.Visible = true
						end
					else
						if entry.distLabel.Visible then
							entry.distLabel.Visible = false
						end
					end

					if showHealth then
						local curHealth = entry.hum.Health
						if entry.lastHealth ~= curHealth then
							entry.lastHealth = curHealth
							local maxH = entry.hum.MaxHealth > 0 and entry.hum.MaxHealth or 100
							local pct = math.clamp(curHealth / maxH, 0, 1)
							entry.healthFill.Size = UDim2.new(pct, 0, 1, 0)
							entry.healthFill.BackgroundColor3 = Color3.fromHSV(pct * 0.33, 1, 1)
						end
						if not entry.healthBg.Visible then
							entry.healthBg.Visible = true
						end
					else
						if entry.healthBg.Visible then
							entry.healthBg.Visible = false
						end
					end

					if showHpText then
						local curHealth = math.floor(entry.hum.Health)
						local hpStr = tostring(curHealth) .. " HP"
						if entry.hpText.Text ~= hpStr then
							entry.hpText.Text = hpStr
						end
						if not entry.hpText.Visible then
							entry.hpText.Visible = true
						end
					else
						if entry.hpText.Visible then
							entry.hpText.Visible = false
						end
					end
				end
			else
				if entry and entry.billboard and entry.billboard.Enabled then entry.billboard.Enabled = false end
				if entry and entry.highlight and entry.highlight.Enabled then entry.highlight.Enabled = false end
			end
		end
	end
end

