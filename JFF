-- Hook Kick function to prevent kicks when Anti-Kick is enabled
local oldKick
pcall(function()
	oldKick = hookmetamethod(game, "__namecall", function(self, ...)
		local method = getnamecallmethod()
		if self == LocalPlayer and (method == "Kick" or method == "kick") then
			if Toggles.AntiKick and Toggles.AntiKick.Value then
				pcall(function()
					Library:Notify({ Title = "Anti-Kick", Description = "Blocked an attempted kick call!", Time = 5 })
