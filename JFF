	local function updateCamlockSlotSystemState()
		if not (Toggles.CamlockSlotSystem and Toggles.CamlockSlotSystem.Value) then return end
		if not isAlive() then return end

		local holding = isAdvanceSlotAllowed(Options.CamlockSlotSystemSlot)

		if holding then
			if clSlotSaved.Camlock == nil then
				clSlotSaved.Camlock = Toggles.Camlock and Toggles.Camlock.Value or false
			end
			if clSlotSaved.Outline == nil then
				clSlotSaved.Outline = Toggles.Outline and Toggles.Outline.Value or false
			end

			if Toggles.Camlock and not Toggles.Camlock.Value then
				fromCLSlotSystem = true
				Toggles.Camlock:SetValue(true)
				fromCLSlotSystem = false
			end
			if Toggles.Outline and not Toggles.Outline.Value then
				fromCLSlotSystem = true
				Toggles.Outline:SetValue(true)
				fromCLSlotSystem = false
			end
		else
			if clSlotSaved.Camlock ~= nil then
				if Toggles.Camlock and Toggles.Camlock.Value ~= clSlotSaved.Camlock then
					fromCLSlotSystem = true
					Toggles.Camlock:SetValue(clSlotSaved.Camlock)
					fromCLSlotSystem = false
				end
				clSlotSaved.Camlock = nil
			end
			if clSlotSaved.Outline ~= nil then
				if Toggles.Outline and Toggles.Outline.Value ~= clSlotSaved.Outline then
					fromCLSlotSystem = true
					Toggles.Outline:SetValue(clSlotSaved.Outline)
					fromCLSlotSystem = false
				end
				clSlotSaved.Outline = nil
			end
		end
	end

	Toggles.CamlockSlotSystem:OnChanged(function()
		disconnect("CamlockSlotSystem_Poll")
		disconnect("CamlockSlotSystem_ChildAdded")
		disconnect("CamlockSlotSystem_ChildRemoved")
		disconnect("CamlockSlotSystem_CharAdded")

		if updatePVPModulesVisibility then
