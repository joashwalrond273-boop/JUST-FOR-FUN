local UserInputService2 = game:GetService("UserInputService")
local lastDeltaX, lastDeltaY = 0, 0

track("ScreenSens", RunService.RenderStepped:Connect(function(dt)
	if not Toggles.Noclip or not Toggles.Noclip.Value then return end
	local mult = Options.ScreenSens and Options.ScreenSens.Value or 1
	if mult == 1 then return end

	local delta = UserInputService2:GetMouseDelta()
	local dx = delta.X - lastDeltaX
	local dy = delta.Y - lastDeltaY

	if math.abs(dx) > 0.01 or math.abs(dy) > 0.01 then
		local cam = workspace.CurrentCamera
		if cam then
			local adjX = dx * (mult - 1)
			local adjY = dy * (mult - 1)
			cam.CFrame = cam.CFrame * CFrame.Angles(0, -math.rad(adjX * 0.3), 0)
			cam.CFrame = CFrame.new(cam.CFrame.Position) * CFrame.Angles(math.rad(adjY * 0.3), 0, 0) * (cam.CFrame - cam.CFrame.Position)
		end
	end
	lastDeltaX = delta.X
	lastDeltaY = delta.Y
end))

