				myRoot.Velocity = Vector3.zero
				myRoot.RotVelocity = Vector3.new(0, speed * 25, 0)
			end
		end))
	else
		if myHum then
			myHum.PlatformStand = false
		end
		local myRoot = getRootPart()
		if myRoot then
			myRoot.RotVelocity = Vector3.zero
		end
