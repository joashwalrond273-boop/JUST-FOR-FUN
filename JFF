task.spawn(function()
	task.wait(1)
	local footerLabel = nil
	if Window.Outer then
		for _, child in ipairs(Window.Outer:GetDescendants()) do
			if child:IsA("TextLabel") and (child.Text:find("FPS:") or child.Text:find("Ping:") or child.Text == "Obsidian UI") then
				footerLabel = child
				break
			end
		end
	end

	if footerLabel then
		local lastTick = tick()
		local frameCount = 0
		track("StatsUpdate", RunService.Heartbeat:Connect(function()
			frameCount += 1
			local curTick = tick()
			if curTick - lastTick >= 0.5 then
				local fps = math.floor(frameCount / (curTick - lastTick))
				frameCount = 0
				lastTick = curTick

				local ping = 0
				local success, pingVal = pcall(function()
					return LocalPlayer:GetNetworkPing() * 1000
				end)
				if success and pingVal then
					ping = math.floor(pingVal)
				end
				footerLabel.Text = string.format("FPS: %d | Ping: %dms", fps, ping)
			end
		end))
	end
end)

