				disconnect("CamlockSlotSystem_ChildAdded")
				disconnect("CamlockSlotSystem_ChildRemoved")
				track("CamlockSlotSystem_ChildAdded", char.ChildAdded:Connect(function(child)
					if child:IsA("Tool") then
