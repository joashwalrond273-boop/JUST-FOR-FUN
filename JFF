local function isAdvanceSlotAllowed(slotOption)
	if not slotOption then return false end
	local val = slotOption.Value
	if val == nil then return false end

	if typeof(val) == "table" then
		for slotKey, isSelected in pairs(val) do
			local targetSlot = nil
			if isSelected == true then
				targetSlot = slotKey
			elseif typeof(isSelected) == "string" then
				targetSlot = isSelected
			elseif typeof(isSelected) == "number" then
				targetSlot = isSelected
			end
			if targetSlot ~= nil then
				if isHoldingSelectedSlot(targetSlot) then
					return true
				end
			end
		end
		return false
	elseif typeof(val) == "string" or typeof(val) == "number" then
		return isHoldingSelectedSlot(val)
	end

	return false
end

local function updateAdvanceState()
	if not (Toggles.Advance and Toggles.Advance.Value) then return end
	if not isAlive() then return end

	local isHoldingSelectedSlot = isAdvanceSlotAllowed(Options.AdvanceSlot)
	local shouldBeImmortal = isHoldingSelectedSlot

	if Toggles.ImmortalMode and Toggles.ImmortalMode.Value ~= shouldBeImmortal then
		Toggles.ImmortalMode:SetValue(shouldBeImmortal)
	end
end

Toggles.Advance:OnChanged(function()
	disconnect("AdvanceSlotCheck")
	disconnect("AdvanceSlot_ChildAdded")
	disconnect("AdvanceSlot_ChildRemoved")
	disconnect("AdvanceSlot_CharAdded")

	if Toggles.Advance.Value then
		local function hookAdvanceChar(char)
			if not char then return end
			disconnect("AdvanceSlot_ChildAdded")
			disconnect("AdvanceSlot_ChildRemoved")
			track("AdvanceSlot_ChildAdded", char.ChildAdded:Connect(function(child)
				if child:IsA("Tool") then
					task.wait()
					updateAdvanceState()
				end
			end))
			track("AdvanceSlot_ChildRemoved", char.ChildRemoved:Connect(function(child)
				if child:IsA("Tool") then
					task.wait()
					updateAdvanceState()
				end
			end))
		end

		if LocalPlayer.Character then
			hookAdvanceChar(LocalPlayer.Character)
		end
		track("AdvanceSlot_CharAdded", LocalPlayer.CharacterAdded:Connect(hookAdvanceChar))

		track("AdvanceSlotCheck", RunService.Heartbeat:Connect(function()
			updateAdvanceState()
		end))

		updateAdvanceState()
	else
		if Toggles.ImmortalMode and Toggles.ImmortalMode.Value then
			Toggles.ImmortalMode:SetValue(false)
		end
	end
end)

