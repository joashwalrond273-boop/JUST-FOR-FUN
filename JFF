local function hookCharFolderBehaviors()
	disconnect("CharFolder_ChildAdded")
	local folder = getCharacterFolder()
	if folder then
		track("CharFolder_ChildAdded", folder.ChildAdded:Connect(function(child)
			if child and child:IsA("Instance") then
				task.wait(0.05)
