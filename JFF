local espObjects = {}
local hasDrawing = (typeof(Drawing) ~= "nil")

local function clearESP()
	for _, obj in pairs(espObjects) do
		if typeof(obj) == "Instance" then
			obj:Destroy()
		elseif typeof(obj) == "table" then
			for _, child in pairs(obj) do
				if typeof(child) == "Instance" then
					child:Destroy()
				else
					pcall(function() child:Remove() end)
				end
			end
		end
	end
	table.clear(espObjects)
end

local function createESP(player)
	local character = player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local hum = character:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		return
	end

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(120, 40)
	billboard.AlwaysOnTop = true
	billboard.Adornee = root
	billboard.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Options and Options.PlayerESPColor and Options.PlayerESPColor.Value or Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.5
	label.Font = Enum.Font.Jura
	label.TextSize = 14
	label.RichText = true
	label.Parent = billboard

	local highlight = Instance.new("Highlight")
	highlight.FillColor = Color3.fromRGB(255, 255, 255)
	highlight.OutlineColor = Options.OutlineESPColor.Value
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.Adornee = character
	highlight.Parent = character
	highlight.Enabled = false

	espObjects[player] = { billboard, label, highlight }

	local function update()
		local myRoot = getRootPart()
		if not myRoot or not character.Parent then
			if highlight then highlight.Enabled = false end
			return
		end
		local dist = (root.Position - myRoot.Position).Magnitude
		local shouldShow = dist <= Options.ESPDistance.Value and Toggles.PlayerESP.Value

		local screenPos, onScreen = workspace.CurrentCamera:WorldToViewportPoint(root.Position)

		billboard.Enabled = shouldShow
		local nameColor = Options and Options.PlayerESPColor and Options.PlayerESPColor.Value or Color3.new(1, 1, 1)
		local distColor = Options and Options.ShowDistanceColor and Options.ShowDistanceColor.Value or Color3.new(1, 1, 1)
		local text = '<font color="#' .. nameColor:ToHex() .. '">' .. player.Name .. '</font>'
		if Toggles.ShowDistance.Value then
			text ..= '\n<font color="#' .. distColor:ToHex() .. '">' .. string.format("%.0fm", dist) .. '</font>'
		end
		label.Text = text

		if highlight then
			if shouldShow and Toggles.OutlineESP and Toggles.OutlineESP.Value then
				highlight.Enabled = true
			else
				highlight.Enabled = false
			end
		end
	end

	update()
	track("ESP_" .. player.Name, RunService.RenderStepped:Connect(update))
end

