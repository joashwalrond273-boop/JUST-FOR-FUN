VisualFPS:AddToggle("LowTextures", {
	Text = "Low Textures",
	Default = false,
	Callback = function(state)
		disconnect("LowTextures")
		if state then
			-- Apply to current parts in batches asynchronously to prevent lag
			local function applyLowTexture(v)
				if v:IsA("BasePart") or v:IsA("MeshPart") then
					pcall(function() v.Material = Enum.Material.Plastic end)
				end
			end

			task.spawn(function()
				local queue = {workspace}
				local head = 1
				local tail = 2
				local count = 0
				while head < tail and Toggles.LowTextures.Value do
					local current = queue[head]
					queue[head] = nil
					head += 1
					if current and current.Parent then
						local success, children = pcall(current.GetChildren, current)
						if success and children then
							for i = 1, #children do
								local child = children[i]
								applyLowTexture(child)
								queue[tail] = child
								tail += 1
							end
						end
					end
					count += 1
					if count % 300 == 0 then
						task.wait()
					end
				end
			end)

			-- Connect descendant added
			track("LowTextures", workspace.DescendantAdded:Connect(function(v)
				if Toggles.LowTextures.Value then
					applyLowTexture(v)
				end
			end))
		end
	end,
})

