			if LocalPlayer.Character then
				hookCamlockSlotChar(LocalPlayer.Character)
			end
			track("CamlockSlotSystem_CharAdded", LocalPlayer.CharacterAdded:Connect(hookCamlockSlotChar))

			track("CamlockSlotSystem_Poll", RunService.Heartbeat:Connect(function()
				updateCamlockSlotSystemState()
			end))

			updateCamlockSlotSystemState()

			Library:Notify({ Title = "Camlock Slot System", Description = "Enabled", Time = 2 })
		else
			if clSlotSaved.Camlock ~= nil then
				if Toggles.Camlock and Toggles.Camlock.Value ~= clSlotSaved.Camlock then
					fromCLSlotSystem = true
					Toggles.Camlock:SetValue(clSlotSaved.Camlock)
					fromCLSlotSystem = false
				end
				clSlotSaved.Camlock = nil
			end
			if clSlotSaved.Outline ~= nil then
				if Toggles.Outline and Toggles.Outline.Value ~= clSlotSaved.Outline then
