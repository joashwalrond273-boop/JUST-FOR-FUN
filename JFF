if Toggles.AutoJump then
	Toggles.AutoJump:OnChanged(function()
		disconnect("AutoJump")
		if updatePVPModulesVisibility then
			updatePVPModulesVisibility()
		end

		if Toggles.AutoJump.Value then
			local lastJumpTime = 0
			local trackedPlayerJumps = {}

			track("AutoJump", RunService.Heartbeat:Connect(function()
				if not isAlive() then return end
				local myRoot = getRootPart()
				local myHum = getHumanoid()
				if not myRoot or not myHum then return end

				if Toggles.AutoJumpSlotSystem and Toggles.AutoJumpSlotSystem.Value then
					if not isAdvanceSlotAllowed(Options.AutoJumpSlotSystemSlot) then
						return
					end
				end

				local maxStuds = (Options.AutoJumpStuds and Options.AutoJumpStuds.Value) or 20
				local jumpDelay = (Options.AutoJumpDelay and Options.AutoJumpDelay.Value) or 0.25
				local ignoreTeam = Toggles.AutoJumpIgnoreTeam and Toggles.AutoJumpIgnoreTeam.Value
				local myPos = myRoot.Position

				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character then
						if not ignoreTeam or not isTeammate(p) then
							local otherRoot = p.Character:FindFirstChild("HumanoidRootPart")
							local otherHum = p.Character:FindFirstChildOfClass("Humanoid")
							if otherRoot and otherHum and otherHum.Health > 0 then
								local dist = (otherRoot.Position - myPos).Magnitude
								if dist <= maxStuds then
									local isJumpingNow = (otherHum:GetState() == Enum.HumanoidStateType.Jumping)
										or (otherHum.Jump == true)
										or (otherHum.FloorMaterial == Enum.Material.Air and (otherRoot.AssemblyLinearVelocity or otherRoot.Velocity or Vector3.zero).Y > 6)

									local wasJumping = trackedPlayerJumps[p] or false
									trackedPlayerJumps[p] = isJumpingNow

									if isJumpingNow and not wasJumping then
										if tick() - lastJumpTime >= jumpDelay then
											lastJumpTime = tick()
											if myHum.FloorMaterial ~= Enum.Material.Air then
												myHum.Jump = true
												pcall(function()
													myHum:ChangeState(Enum.HumanoidStateType.Jumping)
												end)
											end
										end
									end
								else
									trackedPlayerJumps[p] = nil
								end
							else
								trackedPlayerJumps[p] = nil
							end
						else
							trackedPlayerJumps[p] = nil
						end
					end
				end
			end))
		end
	end)
end

Toggles.SwordBot:OnChanged(function()
	disconnect("SwordBot")
	if Toggles.SwordBot.Value then
		local lastSwing = 0
		local orbitAngle = 0
		track("SwordBot", RunService.Heartbeat:Connect(function(dt)
			if not isAlive() then return end
			local root = getRootPart()
			local hum = getHumanoid()
			if not root or not hum then return end

			local targetName = Options.ChooseVictim and Options.ChooseVictim.Value
			local targetPlayer = targetName and Players:FindFirstChild(targetName)
			if not targetPlayer or not targetPlayer.Character or not targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
				local closest, cDist = nil, math.huge
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
						local phum = p.Character:FindFirstChildOfClass("Humanoid")
						if phum and phum.Health > 0 then
							local d = (p.Character.HumanoidRootPart.Position - root.Position).Magnitude
							if d < cDist then
								cDist = d
								closest = p
							end
						end
					end
				end
				targetPlayer = closest
			end

			local targetChar = targetPlayer and targetPlayer.Character
			local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
			local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")

			if not targetRoot or not targetHum or targetHum.Health <= 0 then
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				UserInputService.MouseIconEnabled = true
				hum.AutoRotate = true
				return
			end

			local targetPos = targetRoot.Position
			local myPos = root.Position
			local dist = (targetPos - myPos).Magnitude

			-- Camlock functionality when within 10 studs
			if dist <= 10 then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
				UserInputService.MouseIconEnabled = false
				hum.AutoRotate = false

				local lookDir = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z).Unit
				if lookDir.Magnitude > 0 then
					root.CFrame = CFrame.new(myPos, myPos + lookDir)
				end
			else
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				UserInputService.MouseIconEnabled = true
				hum.AutoRotate = true

				-- Force camera/body lock-on facing target on Y axis
				root.CFrame = CFrame.lookAt(root.Position, Vector3.new(targetPos.X, root.Position.Y, targetPos.Z))
			end

			-- Determine movement position (prevent getting closer than 20 studs)
			local movePos
			if dist > 20.5 then
				-- Head directly to the closest point on the 20-stud perimeter
				local dir = (myPos - targetPos)
				local flatDir = Vector3.new(dir.X, 0, dir.Z)
				if flatDir.Magnitude > 0.1 then
					movePos = targetPos + flatDir.Unit * 20
				else
					movePos = targetPos + Vector3.new(20, 0, 0)
				end
			else
				-- Orbit smoothly at exactly 20 studs
				orbitAngle = orbitAngle + (dt * 5)
				local offset = Vector3.new(math.cos(orbitAngle) * 20, 0, math.sin(orbitAngle) * 20)
				movePos = targetPos + offset
			end

			-- Move to calculated position
			hum:MoveTo(movePos)

			-- Check distance for auto hop and attack (jumping around their body in circles)
			if dist <= 22 then
				-- Constantly Hop
				if hum.FloorMaterial ~= Enum.Material.Air then
					hum.Jump = true
					pcall(function()
						hum:ChangeState(Enum.HumanoidStateType.Jumping)
					end)
				end

				-- Constant auto swing
				local delay = 0.2
				if tick() - lastSwing >= delay then
					local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
					if tool then
						tool:Activate()
						lastSwing = tick()
					end
				end
			end
		end))
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		local hum = getHumanoid()
		local root = getRootPart()
		if hum then
			hum.AutoRotate = true
			if root then
				hum:MoveTo(root.Position)
			end
		end
	end
end)

