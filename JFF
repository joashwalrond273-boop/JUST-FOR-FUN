Toggles.Camlock:OnChanged(function()
	disconnect("Camlock")
	if updatePVPModulesVisibility then
		updatePVPModulesVisibility()
	end
	if Toggles.Camlock.Value then
		track("Camlock", RunService.RenderStepped:Connect(function(dt)
			if not isAlive() then return end
			local root = getRootPart()
			local hum = getHumanoid()
			if not root or not hum then return end

			local maxDist = Options.CamlockStuds and Options.CamlockStuds.Value or 20
			local myPos = root.Position
			local closestPlayer = nil
			local closestDist = math.huge
			local targetSetting = Options.CamlockTarget and Options.CamlockTarget.Value or "All"
			local ignoreTeam = true

			local function isSameTeamOnly(p)
				if LocalPlayer.Team and p.Team and LocalPlayer.Team == p.Team then
					return true
				end
				if LocalPlayer.TeamColor and p.TeamColor and LocalPlayer.TeamColor == p.TeamColor and LocalPlayer.TeamColor ~= BrickColor.new("White") then
					return true
				end
				return false
			end

			for _, otherPlayer in ipairs(Players:GetPlayers()) do
				if otherPlayer ~= LocalPlayer and otherPlayer.Character then
					if not ignoreTeam or not isSameTeamOnly(otherPlayer) then
						local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
						local otherHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
						if otherRoot and otherHum and otherHum.Health > 0 then
							if targetSetting == "All" or otherPlayer.Name == targetSetting then
								local dist = (otherRoot.Position - myPos).Magnitude
								if dist <= maxDist and dist < closestDist then
									closestDist = dist
									closestPlayer = otherPlayer
								end
							end
						end
					end
				end
			end

			-- Outline: Stop player from getting closer than studs to players while using Camlock
			local outlineActive = (Toggles.Outline and Toggles.Outline.Value) or (Toggles.Cutline and Toggles.Cutline.Value)
			local minOutlineStuds = (Options.OutlineStuds and Options.OutlineStuds.Value) or (Options.CutlineStuds and Options.CutlineStuds.Value) or 7

			if outlineActive then
				local outlineTargetSetting = (Options.OutlineTarget and Options.OutlineTarget.Value) or "All"
				for _, otherPlayer in ipairs(Players:GetPlayers()) do
					if otherPlayer ~= LocalPlayer and otherPlayer.Character then
						if not ignoreTeam or not isSameTeamOnly(otherPlayer) then
							local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
							local otherHum = otherPlayer.Character:FindFirstChildOfClass("Humanoid")
							if otherRoot and otherHum and otherHum.Health > 0 then
								if outlineTargetSetting == "All" or otherPlayer.Name == outlineTargetSetting then
									local otherPos = otherRoot.Position
									local offset = myPos - otherPos
									local flatOffset = Vector3.new(offset.X, 0, offset.Z)
									local flatDist = flatOffset.Magnitude

									if flatDist < minOutlineStuds then
										local pushDir
										if flatDist > 0.001 then
											pushDir = flatOffset.Unit
										else
											local backDir = -root.CFrame.LookVector
											local flatBack = Vector3.new(backDir.X, 0, backDir.Z)
											pushDir = flatBack.Magnitude > 0.001 and flatBack.Unit or Vector3.new(0, 0, 1)
										end

										myPos = Vector3.new(
											otherPos.X + pushDir.X * minOutlineStuds,
											myPos.Y,
											otherPos.Z + pushDir.Z * minOutlineStuds
										)

										pcall(function()
											local vel = root.AssemblyLinearVelocity or root.Velocity
											if vel then
												local moveTowards = vel.X * (-pushDir.X) + vel.Z * (-pushDir.Z)
												if moveTowards > 0 then
													local correctedVel = Vector3.new(
														vel.X - (-pushDir.X * moveTowards),
														vel.Y,
														vel.Z - (-pushDir.Z * moveTowards)
													)
													root.AssemblyLinearVelocity = correctedVel
													root.Velocity = correctedVel
												end
											end
										end)
									end
								end
							end
						end
					end
				end
			end

			-- Slight Pull In at 8 studs: Gently pulls forward into outline distance (never closer than outline)
			local isPullActive = (Toggles.CamlockPull and Toggles.CamlockPull.Value) or false
			if isPullActive and closestPlayer and closestPlayer.Character then
				local targetRoot = closestPlayer.Character:FindFirstChild("HumanoidRootPart")
				if targetRoot then
					local targetPos = targetRoot.Position
					local offset = targetPos - myPos
					local flatOffset = Vector3.new(offset.X, 0, offset.Z)
					local currentDist = flatOffset.Magnitude

					local pullTriggerDist = (Options.CamlockPullDist and Options.CamlockPullDist.Value) or 8
					local stopBoundary = outlineActive and minOutlineStuds or 7

					local pullDir = flatOffset.Magnitude > 0.0001 and flatOffset.Unit or Vector3.zero

					-- Check if the player is actively trying to move / pull away from the target
					local isMovingAway = false
					if hum and hum.MoveDirection.Magnitude > 0.05 then
						if hum.MoveDirection:Dot(pullDir) < -0.05 then
							isMovingAway = true
						end
					end
					if not isMovingAway and (UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down)) then
						isMovingAway = true
					end

					local pullStrength = (Options.CamlockPullStrength and Options.CamlockPullStrength.Value) or 5
					local maxStep = pullStrength * 0.08
					local velMag = pullStrength * 2.8

					if not isMovingAway and currentDist <= pullTriggerDist and currentDist > stopBoundary then
						local pullStep = math.min(currentDist - stopBoundary, maxStep)
						myPos = Vector3.new(
							myPos.X + pullDir.X * pullStep,
							myPos.Y,
							myPos.Z + pullDir.Z * pullStep
						)

						pcall(function()
							local maxVelAllowed = math.max(0, (currentDist - stopBoundary)) / 0.016
							local safeVelMag = math.min(velMag, maxVelAllowed)
							local pullVel = pullDir * safeVelMag
							local curVel = root.AssemblyLinearVelocity or root.Velocity or Vector3.zero
							local flatCur = Vector3.new(curVel.X, 0, curVel.Z)
							local curTowards = flatCur:Dot(pullDir)
							local desiredTowards = math.max(curTowards, safeVelMag)
							local deltaTowards = desiredTowards - curTowards
							local newFlat = flatCur + pullDir * deltaTowards
							local newVel = Vector3.new(newFlat.X, curVel.Y, newFlat.Z)
							root.AssemblyLinearVelocity = newVel
							root.Velocity = newVel
						end)
					elseif currentDist <= stopBoundary and pullDir.Magnitude > 0 then
						pcall(function()
							local curVel = root.AssemblyLinearVelocity or root.Velocity or Vector3.zero
							local flatCur = Vector3.new(curVel.X, 0, curVel.Z)
							local curTowards = flatCur:Dot(pullDir)
							if curTowards > 0 then
								local newFlat = flatCur - pullDir * curTowards
								local newVel = Vector3.new(newFlat.X, curVel.Y, newFlat.Z)
								root.AssemblyLinearVelocity = newVel
								root.Velocity = newVel
							end
						end)
					end
				end
			end

			if closestPlayer then
				UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
				UserInputService.MouseIconEnabled = false

				local targetRoot = closestPlayer.Character:FindFirstChild("HumanoidRootPart")
				if targetRoot then
					local targetPos = targetRoot.Position
					local lookDir = Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z).Unit
					if lookDir.Magnitude > 0 then
						hum.AutoRotate = false

						local angleOffset = 0
						if isHoldingSelectedSlot(3) or isHoldingSelectedSlot("3") then
							local deg = (Options.Slot3AngleOffset and Options.Slot3AngleOffset.Value) or 8
							angleOffset = -math.rad(deg)
						end

						root.CFrame = CFrame.new(myPos, myPos + lookDir) * CFrame.Angles(0, angleOffset, 0)
					else
						root.CFrame = CFrame.new(myPos, myPos + root.CFrame.LookVector)
					end

					-- True Camera Interpolation (Smooth Lerp)
					if Toggles.CamlockCameraLerp and Toggles.CamlockCameraLerp.Value then
						local camera = workspace.CurrentCamera
						if camera then
							local aimPartName = (Options.CamlockAimPart and Options.CamlockAimPart.Value) or "Head"
							local aimPart = closestPlayer.Character:FindFirstChild(aimPartName) or closestPlayer.Character:FindFirstChild("HumanoidRootPart") or targetRoot
							if aimPart then
								local aimPos = aimPart.Position
								local yOff = (Options.CamlockYOffset and Options.CamlockYOffset.Value) or 0
								if yOff ~= 0 then
									aimPos = aimPos + Vector3.new(0, yOff, 0)
								end
								local pred = (Options.CamlockPrediction and Options.CamlockPrediction.Value) or 0
								if pred > 0 then
									local targetVel = targetRoot.AssemblyLinearVelocity or targetRoot.Velocity or Vector3.zero
									aimPos = aimPos + (targetVel * (pred * 0.1))
								end
								local targetCamCFrame = CFrame.new(camera.CFrame.Position, aimPos)
								local smoothness = (Options.CamlockSmoothness and Options.CamlockSmoothness.Value) or 0.2
								local lerpFactor = math.clamp(smoothness, 0.01, 1)
								camera.CFrame = camera.CFrame:Lerp(targetCamCFrame, lerpFactor)
							end
						end
					end
				end
			else
				UserInputService.MouseBehavior = Enum.MouseBehavior.Default
				UserInputService.MouseIconEnabled = true
				hum.AutoRotate = true
				if outlineActive and (root.Position - myPos).Magnitude > 0.01 then
					root.CFrame = CFrame.new(myPos, myPos + root.CFrame.LookVector)
				end
			end
		end))
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		local hum = getHumanoid()
		if hum then
			hum.AutoRotate = true
		end
	end
end)

